[Unit]
Description=GoShare file sharing server
After=network.target

[Service]
Type=simple
User=goshare
Group=goshare
ExecStart=/usr/local/bin/goshare --config /etc/goshare/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/goshare
PrivateTmp=true

[Install]
WantedBy=multi-user.target
